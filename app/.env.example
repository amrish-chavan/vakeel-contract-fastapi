# Example environment variables
# Copy this file to `.env` (or `app/.env`) and fill in real values.
# This file is safe to commit; `.env` is gitignored.

# MongoDB connection string used by the API
MONGODB_URI=mongodb://root:root@localhost:27017

# MongoDB container credentials (used by docker-compose via env_file)
# Use strong, non-default values in production.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change_me_strong_password

GEMINI_API_KEY=your_gemini_api_key_here
